{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-access-privacy:schema:prototype:0.1",
  "$comment": "EXP-001 — EXPLORATORY PROTOTYPE, NON-NORMATIVE. This schema does not define AI Access Privacy and is not a standard. It validates the shape of a modeling experiment only. The identifier is a URN precisely because no domain has been adopted for this project and no schema URL is owned; do not substitute a domain-based $id until one exists. This schema is deliberately permissive and will pass documents containing typos and unknown fields — see OPEN_QUESTIONS.md Q12. Do not implement.",
  "title": "AI Access Declaration (Exploratory Prototype)",
  "description": "Non-normative shape produced by a modeling experiment. Retained as evidence, not as a specification.",
  "type": "object",
  "required": [
    "prototype_version",
    "declaration_id",
    "issued_at",
    "issuer",
    "ai_system",
    "access_grants",
    "revocation"
  ],
  "additionalProperties": true,
  "properties": {
    "prototype_version": {
      "const": "0.1-exploratory",
      "$comment": "Deliberately not named spec_version, and deliberately not a plain semver — an instance document must not read as conformant to a standard."
    },
    "declaration_id": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "issuer": {
      "type": "object",
      "required": ["name", "contact", "role"],
      "properties": {
        "name": { "type": "string" },
        "uri": { "type": "string", "format": "uri" },
        "contact": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["resource-owner", "ai-operator", "third-party-auditor"],
          "$comment": "Open question 2: these three roles perform different speech acts (grant / claim / attestation) but share one document shape."
        }
      }
    },
    "ai_system": {
      "type": "object",
      "required": ["name", "operator", "agentic"],
      "properties": {
        "name": { "type": "string" },
        "operator": { "type": "string" },
        "model_family": { "type": "string" },
        "agentic": { "type": "boolean" },
        "identifier": { "type": "string" }
      }
    },
    "access_grants": {
      "type": "array",
      "minItems": 1,
      "$comment": "Open question 8: no composition model — delegation chains cannot be expressed.",
      "items": {
        "type": "object",
        "required": ["resource", "permitted_operations", "purpose"],
        "properties": {
          "resource": {
            "type": "object",
            "required": ["type", "identifier"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["data", "identity", "tool", "service", "execution"],
                "$comment": "Open question 3: treated here as a partition, but these overlap in practice."
              },
              "identifier": { "type": "string" }
            }
          },
          "permitted_operations": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "purpose": {
            "type": "string",
            "$comment": "Open question 4: unverifiable free text carrying most of the privacy weight."
          },
          "conditions": {
            "type": "array",
            "items": { "type": "string" },
            "$comment": "Open question 5: prose, with no semantics of evaluation."
          },
          "data_exposure": {
            "type": "object",
            "properties": {
              "classes": { "type": "array", "items": { "type": "string" } },
              "retention": { "type": "string" },
              "training_use": { "type": "boolean" }
            }
          },
          "identity_context": {
            "type": "object",
            "properties": {
              "on_behalf_of": {
                "type": "string",
                "enum": ["end-user", "service-account", "autonomous"]
              },
              "delegation": { "type": "string" }
            }
          },
          "authorization": {
            "type": "object",
            "$comment": "Open question 9: possible leak across the boundary drawn in CATEGORY_BOUNDARY.md.",
            "properties": {
              "mechanism": { "type": "string" },
              "reference": { "type": "string" }
            }
          }
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation"],
        "properties": {
          "resource": { "type": "object" },
          "operation": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "$comment": "Open question 6: conflates verifying truthfulness with verifying boundedness.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unverified", "self-attested", "third-party-verified"]
        },
        "method": { "type": "string" },
        "verified_by": { "type": "string" },
        "evidence_uri": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "observation": {
      "type": "object",
      "properties": {
        "logging": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "frequency": { "type": "string" }
      }
    },
    "revocation": {
      "type": "object",
      "required": ["status"],
      "$comment": "Open question 7: unclear whether lifecycle belongs to the declaration or the underlying grant.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "revoked"]
        },
        "revoked_at": { "type": "string", "format": "date-time" },
        "uri": { "type": "string" },
        "contact": { "type": "string" }
      }
    }
  }
}
